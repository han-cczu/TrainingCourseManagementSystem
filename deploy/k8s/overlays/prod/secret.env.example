# 生产密钥模板。首次运行 deploy/deploy.ps1 会自动生成同目录的 secret.env（随机值），一般无需手动复制。
# secret.env 已被 .gitignore 忽略，切勿提交；请另行备份，丢失后数据库密码将无法对上。
# 注意：MySQL 只在首次初始化数据卷时读取密码，之后修改这里的数据库密码不会自动生效。
MYSQL_ROOT_PASSWORD=change-me
DB_PASSWORD=change-me
# 至少 32 字节的随机字符串
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
ADMIN_USERNAME=admin
# 8-64 位，至少包含字母和数字
ADMIN_PASSWORD=change-me-123
