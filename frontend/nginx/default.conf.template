# 由 nginx 镜像启动时 envsubst 渲染：只替换已定义的环境变量（BACKEND_URL），$host 等 nginx 变量保持不变

# 登录/注册按客户端 IP 限流（技术设计 §9.4）；每个前端副本各自计数
limit_req_zone $binary_remote_addr zone=auth:10m rate=30r/m;
limit_req_status 429;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 1m;

    # 超限时返回与后端一致的 JSON 错误体
    error_page 429 = @too_many_requests;

    location ~ ^/api/auth/(login|register)$ {
        limit_req zone=auth burst=20 nodelay;
        include /etc/nginx/snippets/proxy-headers.conf;
        include /etc/nginx/snippets/security-headers.conf;
        proxy_pass ${BACKEND_URL};
    }

    location /api/ {
        include /etc/nginx/snippets/proxy-headers.conf;
        include /etc/nginx/snippets/security-headers.conf;
        proxy_pass ${BACKEND_URL};
    }

    # 带 hash 的静态资源长缓存
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=2592000, immutable" always;
        try_files $uri =404;
    }

    # SPA 路由回退；index.html 不缓存，保证发版后立即生效
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }

    location @too_many_requests {
        default_type application/json;
        return 429 '{"code":"TOO_MANY_REQUESTS","message":"操作过于频繁，请稍后再试"}';
    }
}
